.top-status { flex-direction: row; align-items: center; height: 54px; }
.status-icon { width: 50px; color: #294273; font-size: 27px; text-align: center; }
.clock { width: 90px; color: #294273; font-size: 25px; font-weight: normal; text-align: center; }
.settings-entry { width: 70px; height: 48px; color: #294273; font-size: 18px; text-align: center; line-height: 48px; }
.content { height: 634px; }
.page { height: 634px; padding: 0 30px 18px; }
.glass-card, .system-strip, .action-card, .health-banner, .metric-card, .network-card, .trend-card, .advice-card, .task-main-card, .progress-card, .task-control-card, .bubble, .answer-bubble, .tool-card, .ai-reminder-strip, .setting-card { background-color: #fbfcff; border-width: 1px; border-color: #ffffff; border-radius: 22px; }
.card-title { color: #17254a; font-size: 23px; font-weight: bold; }
.home-page { flex-direction: column; }
.home-upper { width: 100%; height: 334px; flex-direction: row; justify-content: space-between; }
