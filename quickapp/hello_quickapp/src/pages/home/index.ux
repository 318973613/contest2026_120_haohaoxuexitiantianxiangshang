<template>
  <div class="app">
    <div class="topbar">
      <text class="screen-title" if="{{ currentPage === 'home' }}">AI 智能学习与调试终端</text>
      <text class="screen-title" if="{{ currentPage === 'status' }}">系统状态</text>
      <text class="screen-title" if="{{ currentPage === 'tasks' }}">学习任务</text>
      <text class="screen-title" if="{{ currentPage === 'ai' }}">AI 助手</text>
      <text class="screen-title" if="{{ currentPage === 'settings' }}">设置</text>
      <div class="top-status">
        <text class="top-chip">WiFi</text>
        <text class="top-chip">{{ batteryDisplay }}</text>
        <text class="clock">{{ nowText }}</text>
        <text class="settings-entry" onclick="showSettings">设置</text>
      </div>
    </div>

    <div class="content">
      <div class="page home-page" if="{{ currentPage === 'home' }}">
        <div class="home-upper">
          <div class="glass-card today-card">
            <text class="card-title">今日重点</text>
            <div class="focus-task"><text class="task-icon blue-soft">声</text><div class="focus-task-copy"><text class="focus-task-title">{{ nextTaskText }}</text><div class="progress-track"><div class="progress-fill progress-blue"></div></div></div><text class="progress-text">60%</text></div>
            <div class="focus-task"><text class="task-icon green-soft">学</text><div class="focus-task-copy"><text class="focus-task-title">{{ pendingCount }} 项任务待完成</text><div class="progress-track"><div class="progress-fill progress-green"></div></div></div><text class="progress-text">30%</text></div>
          </div>
          <div class="glass-card ai-reminder-card"><text class="card-title">AI 提醒</text><text class="ai-orb">AI</text><text class="reminder-copy">保持当前节奏，完成一项后记得短暂休息</text></div>
        </div>
        <div class="system-strip"><text class="system-ok">系统运行正常</text><text class="strip-value">网络  {{ networkType }}</text><text class="strip-dot">·</text><text class="strip-value">存储  {{ availableStorage }}</text><text class="strip-dot">·</text><text class="strip-value">运行  {{ sessionTime }}</text></div>
        <div class="home-actions"><div class="action-card" onclick="showStatus"><text class="action-icon blue-action">调</text><text class="action-title">快速调试</text><text class="action-arrow">&gt;</text></div><div class="action-card" onclick="showTasks"><text class="action-icon purple-action">学</text><text class="action-title">学习资料</text><text class="action-arrow">&gt;</text></div></div>
      </div>

      <div class="page status-page" if="{{ currentPage === 'status' }}">
        <div class="health-banner"><text class="shield-icon">稳</text><div class="health-copy"><text class="health-title">运行稳定</text><text class="health-sub">系统运行正常，所有服务状态良好</text></div><input id="status-refresh" type="button" class="refresh-btn" value="刷新" onclick="refreshStatus" /></div>
        <div class="metric-grid"><div class="metric-card"><text class="metric-title blue-text">网络</text><text class="metric-main small-main">{{ networkType }}</text><text class="metric-sub">连接状态</text></div><div class="metric-card"><text class="metric-title purple-text">电量</text><text class="metric-main">{{ batteryDisplay }}</text><text class="metric-sub">{{ charging ? '正在充电' : '设备供电' }}</text></div><div class="metric-card"><text class="metric-title green-text">存储</text><text class="metric-main small-main">{{ availableStorage }}</text><text class="metric-sub">总计 {{ totalStorage }}</text></div><div class="metric-card"><text class="metric-title orange-text">会话</text><text class="metric-main small-main">{{ sessionTime }}</text><text class="metric-sub">运行时间</text></div></div>
        <div class="status-bottom"><div class="network-card"><text class="card-title">设备信息</text><text class="detail-line">{{ deviceModel }}</text><text class="detail-line">{{ osVersion }}</text></div><div class="trend-card"><text class="card-title">性能趋势</text><text class="trend-wave">低    中    高</text><text class="trend-label">稳定运行 · {{ screenSize }}</text></div><div class="advice-card"><text class="card-title">AI 建议</text><text class="advice-copy">保持网络连接，定期整理任务记录</text><text class="detail-line">平台 {{ platformVersion }}</text></div></div>
      </div>

      <div class="page tasks-page" if="{{ currentPage === 'tasks' }}">
        <div class="task-main-card"><text class="card-title">今日任务</text><list class="task-list"><list-item type="empty" class="empty-state" if="{{ taskCount === 0 }}"><text class="empty-title">还没有学习任务</text></list-item><list-item type="task" class="task-row" for="{{ tasks }}"><text class="task-icon {{ $item.done ? 'green-soft' : 'blue-soft' }}">{{ $item.done ? '完' : '学' }}</text><div class="task-copy"><text class="{{ $item.done ? 'task-text task-done' : 'task-text' }}">{{ $item.text }}</text><text class="task-state">{{ $item.done ? '已完成' : '待完成' }}</text></div></list-item></list></div>
        <div class="task-side"><div class="progress-card"><text class="card-title">今日进度</text><text class="progress-ring">{{ doneCount }}/{{ taskCount }}</text><text class="progress-caption">已完成</text></div><div class="task-control-card"><text class="card-title">新建任务</text><div class="task-input-shell"><text class="task-input-shell-text">{{ taskInput ? taskInput : '输入学习任务' }}</text></div><input id="task-input" type="text" class="task-inline-input" maxlength="40" placeholder="输入学习任务" value="{{ taskInput }}" onchange="onTaskInput" /><input id="task-add" type="button" class="primary-pill" value="+ 添加任务" onclick="addTask" /><input id="task-complete" type="button" class="soft-pill" value="完成下一项" onclick="completeNextTask" /><input id="task-clean" type="button" class="soft-pill danger-text" value="移除已完成" onclick="removeCompletedTasks" /><text class="form-message">{{ taskMessage }}</text></div></div>
      </div>

      <div class="page ai-page" if="{{ currentPage === 'ai' }}">
        <div class="ai-main"><div class="bubble-row"><text class="avatar ai-avatar">AI</text><text class="bubble ai-bubble">你好！我可以帮你学习、调试和优化系统，有什么需要？</text></div><div class="bubble-row user-row" if="{{ lastQuestion }}"><text class="bubble user-bubble">{{ lastQuestion }}</text><text class="avatar user-avatar">你</text></div><div class="bubble-row"><text class="avatar ai-avatar">AI</text><div class="answer-bubble"><list class="answer-list"><list-item type="answer" class="answer-row" for="{{ aiReplyLines }}"><text class="answer-text">{{ $item }}</text></list-item></list></div></div><div class="ai-quick-row"><input type="button" class="quick-tool" value="记录任务" onclick="showTasks" /><input id="ai-status-preset" type="button" class="quick-tool" value="查看状态" onclick="askStatusPreset" /><input type="button" class="quick-tool" value="开始专注" onclick="showHome" /></div></div>
        <div class="tool-card"><text class="tool-icon">工</text><text class="tool-title">{{ aiBusy ? '工具调用中' : 'AI 已就绪' }}</text><text class="tool-sub">{{ voiceListening ? '正在听取语音' : '连接 ai_agent 服务' }}</text><div class="tool-progress"></div></div>
        <div class="ai-reminder-strip"><text class="blue-text">提醒</text><text class="reminder-time">10:45</text><text class="reminder-task">{{ nextTaskText }}</text><input id="reminder-test" type="button" class="running-pill" value="10 秒测试" onclick="startReminderTest" /></div>
        <div class="ai-input-shell"><text class="ai-input-shell-text">{{ aiQuery ? aiQuery : '输入问题或使用语音...' }}</text></div><input id="ai-input" type="text" class="ai-inline-input" maxlength="120" placeholder="输入问题或使用语音..." value="{{ aiQuery }}" onchange="onAiInput" />
        <div class="voice-actions"><input id="voice-start" type="button" class="voice-pill" value="{{ voiceListening ? '正在听' : '开始说话' }}" onclick="startVoiceInput" /><input id="voice-stop" type="button" class="voice-pill stop-pill" value="停止并识别" onclick="stopVoiceInput" /><input id="ai-send" type="button" class="send-pill" value="{{ aiBusy ? '处理中' : '发送' }}" onclick="askAI" /></div><text class="ai-message">{{ aiMessage }}</text>
      </div>

      <div class="page settings-page" if="{{ currentPage === 'settings' }}">
        <div class="settings-grid"><div class="setting-card"><text class="setting-icon purple-action">人</text><div class="setting-copy"><text class="setting-title">账号与设备</text><text class="setting-sub">openvela 学习终端</text></div></div><div class="setting-card"><text class="setting-icon purple-action">专</text><div class="setting-copy"><text class="setting-title">学习模式 / 专注模式</text><text class="setting-sub">25 分钟专注计时</text></div><switch id="focus-switch" checked="{{ focusModeEnabled }}" onchange="onFocusModeSetting"></switch></div><div class="setting-card"><text class="setting-icon blue-action">网</text><div class="setting-copy"><text class="setting-title">Wi-Fi 与网络</text><text class="setting-sub">已连接 · {{ networkType }}</text></div></div><div class="setting-card"><text class="setting-icon blue-action">AI</text><div class="setting-copy"><text class="setting-title">AI 服务配置</text><text class="setting-sub">模型与偏好设置</text></div></div><div class="setting-card"><text class="setting-icon purple-action">声</text><div class="setting-copy"><text class="setting-title">声音与提醒</text><text class="setting-sub">主动提醒与语音输入</text></div><switch id="reminder-switch" checked="{{ remindersEnabled }}" onchange="onReminderSetting"></switch></div><div class="setting-card"><text class="setting-icon green-soft">同</text><div class="setting-copy"><text class="setting-title">数据同步与日志</text><text class="setting-sub">自动刷新设备状态</text></div><switch id="refresh-switch" checked="{{ autoRefreshEnabled }}" onchange="onAutoRefreshSetting"></switch></div><div class="setting-card"><text class="setting-icon orange-soft">亮</text><div class="setting-copy"><text class="setting-title">屏幕亮度</text><text class="setting-sub">跟随设备设置</text></div></div><div class="setting-card"><text class="setting-icon gray-soft">i</text><div class="setting-copy"><text class="setting-title">关于设备</text><text class="setting-sub">Demo 1.0.0 · {{ deviceModel }}</text></div><input id="reset-demo" type="button" class="reset-mini" value="重置" onclick="resetDemoData" /></div></div><text class="settings-message">{{ settingsMessage }}</text>
      </div>

    </div>

    <div class="notice" if="{{ reminderText }}" onclick="dismissNotice">
      <text class="notice-title">提醒</text>
      <text class="notice-text">{{ reminderText }}</text>
      <text class="notice-close">关闭</text>
    </div>

    <div class="bottom-nav" if="{{ currentPage !== 'settings' }}">
      <div id="nav-home" class="{{ currentPage === 'home' ? 'nav-item nav-active' : 'nav-item' }}" onclick="showHome">
        <text class="nav-symbol">首</text><text class="nav-label">首页</text>
      </div>
      <div id="nav-status" class="{{ currentPage === 'status' ? 'nav-item nav-active' : 'nav-item' }}" onclick="showStatus">
        <text class="nav-symbol">状</text><text class="nav-label">状态</text>
      </div>
      <div id="nav-tasks" class="{{ currentPage === 'tasks' ? 'nav-item nav-active' : 'nav-item' }}" onclick="showTasks">
        <text class="nav-symbol">任</text><text class="nav-label">任务</text>
      </div>
      <div id="nav-ai" class="{{ currentPage === 'ai' ? 'nav-item nav-active' : 'nav-item' }}" onclick="showAi">
        <text class="nav-symbol">AI</text><text class="nav-label">助手</text>
      </div>
    </div>
    <div class="bottom-nav settings-nav" if="{{ currentPage === 'settings' }}"><div class="settings-item" onclick="showHome"><text class="nav-symbol">首</text><text class="nav-label">首页</text></div><div class="settings-item" onclick="showStatus"><text class="nav-symbol">状</text><text class="nav-label">状态</text></div><div class="settings-item" onclick="showTasks"><text class="nav-symbol">任</text><text class="nav-label">任务</text></div><div class="settings-item" onclick="showAi"><text class="nav-symbol">AI</text><text class="nav-label">助手</text></div><div class="settings-item nav-active"><text class="nav-symbol">设</text><text class="nav-label">设置</text></div></div>

  </div>
</template>
<script>
import storage from '@system.storage'
import network from '@system.network'
import battery from '@system.battery'
import device from '@system.device'
import velaclaw from '@system.velaclaw'

const TASKS_KEY = 'study_terminal_tasks_v1'
const SETTINGS_KEY = 'study_terminal_settings_v1'

export default {
  private: {
    currentPage: 'home',
    nowText: '--:--',
    dateText: '',
    sessionTime: '00:00',
    startedAt: 0,
    clockTimer: null,
    focusSeconds: 1500,
    focusTime: '25:00',
    focusRunning: false,
    focusTimer: null,
    reminderTimer: null,
    reminderText: '',

    tasks: [
      { id: 1, text: '复习 openvela Quick App 基础', done: false },
      { id: 2, text: '验证 AI 助手工具调用', done: false },
      { id: 3, text: '整理今日演示记录', done: true }
    ],
    taskInput: '',
    taskMessage: '',
    taskCount: 3,
    doneCount: 1,
    pendingCount: 2,
    nextTaskText: '复习 openvela Quick App 基础',

    networkType: '检测中',
    networkOnline: false,
    batteryLevel: '--',
    batteryDisplay: '不可用',
    charging: false,
    availableStorage: '--',
    totalStorage: '--',
    deviceModel: 'openvela 设备',
    osVersion: '--',
    screenSize: '--',
    platformVersion: '--',
    statusUpdated: '--:--',
    autoRefreshTimer: null,

    aiQuery: '',
    lastQuestion: '',
    aiReply: '你好，我可以帮助你安排学习任务、分析设备状态，也可以回答学习问题。',
    aiReplyLines: ['你好，我可以帮助你安排学习任务、分析设备状态，也可以回答学习问题。'],
    aiBusy: false,
    aiMessage: '',
    voiceListening: false,

    remindersEnabled: true,
    autoRefreshEnabled: true,
    focusModeEnabled: true,
    settingsMessage: ''
  },

  onInit() {
    this.startedAt = Date.now()
    this.updateClock()
    this.syncTaskSummary()
    this.loadTasks()
    this.loadSettings()
    this.refreshStatus()
    this.clockTimer = setInterval(() => {
      this.updateClock()
    }, 1000)
    if (network && typeof network.subscribe === 'function') {
      network.subscribe({
        callback: (data) => {
          this.applyNetworkType(data.type)
        }
      })
    }
  },

  onDestroy() {
    this.stopFocusTimer()
    this.stopAutoRefresh()
    if (this.clockTimer) {
      clearInterval(this.clockTimer)
      this.clockTimer = null
    }
    if (this.reminderTimer) {
      clearTimeout(this.reminderTimer)
      this.reminderTimer = null
    }
    if (network && typeof network.unsubscribe === 'function') {
      network.unsubscribe()
    }
  },

  showHome() {
    this.currentPage = 'home'
  },

  showStatus() {
    this.currentPage = 'status'
    this.refreshStatus()
  },

  showTasks() {
    this.currentPage = 'tasks'
  },

  showAi() {
    this.currentPage = 'ai'
  },

  showSettings() {
    this.currentPage = 'settings'
  },

  pad2(value) {
    return value < 10 ? '0' + value : '' + value
  },

  updateClock() {
    const now = new Date()
    this.nowText = this.pad2(now.getHours()) + ':' + this.pad2(now.getMinutes())
    this.dateText = (now.getMonth() + 1) + ' 月 ' + now.getDate() + ' 日'
    const elapsed = Math.max(0, Math.floor((Date.now() - this.startedAt) / 1000))
    const hours = Math.floor(elapsed / 3600)
    const minutes = Math.floor((elapsed % 3600) / 60)
    const seconds = elapsed % 60
    this.sessionTime = hours > 0
      ? this.pad2(hours) + ':' + this.pad2(minutes) + ':' + this.pad2(seconds)
      : this.pad2(minutes) + ':' + this.pad2(seconds)
  },

  formatDuration(seconds) {
    const minutes = Math.floor(seconds / 60)
    const rest = seconds % 60
    return this.pad2(minutes) + ':' + this.pad2(rest)
  },

  toggleFocus() {
    if (!this.focusModeEnabled) {
      this.reminderText = '请先在设置中开启专注模式'
      return
    }
    if (this.focusRunning) {
      this.stopFocusTimer()
      return
    }
    this.focusRunning = true
    this.focusTimer = setInterval(() => {
      if (this.focusSeconds > 0) {
        this.focusSeconds -= 1
        this.focusTime = this.formatDuration(this.focusSeconds)
      }
      if (this.focusSeconds <= 0) {
        this.stopFocusTimer()
        if (this.remindersEnabled) {
          this.reminderText = '本轮专注已完成，现在休息一下吧'
        }
      }
    }, 1000)
  },

  stopFocusTimer() {
    if (this.focusTimer) {
      clearInterval(this.focusTimer)
      this.focusTimer = null
    }
    this.focusRunning = false
  },

  resetFocus() {
    this.stopFocusTimer()
    this.focusSeconds = 1500
    this.focusTime = '25:00'
  },

  startReminderTest() {
    if (!this.remindersEnabled) {
      this.reminderText = '主动提醒已关闭，可在设置中重新开启'
      return
    }
    if (this.reminderTimer) {
      clearTimeout(this.reminderTimer)
    }
    this.reminderText = '测试提醒已设置，10 秒后提示休息'
    this.reminderTimer = setTimeout(() => {
      this.reminderTimer = null
      this.reminderText = '学习了一会儿，现在休息 1 分钟吧'
    }, 10000)
  },

  dismissNotice() {
    this.reminderText = ''
  },

  onTaskInput(event) {
    this.taskInput = event.value || ''
  },

  addTask() {
    const text = (this.taskInput || '').trim()
    if (!text) {
      this.taskMessage = '请先输入任务内容'
      return
    }
    const task = {
      id: Date.now(),
      text: text,
      done: false
    }
    this.tasks = this.tasks.concat([task])
    this.taskInput = ''
    this.taskMessage = '任务已添加并保存'
    this.syncTaskSummary()
    this.saveTasks()
  },

  completeNextTask() {
    let changed = false
    const nextTasks = []
    for (let i = 0; i < this.tasks.length; i += 1) {
      const source = this.tasks[i]
      const task = { id: source.id, text: source.text, done: source.done }
      if (!changed && !task.done) {
        task.done = true
        changed = true
      }
      nextTasks.push(task)
    }
    if (!changed) {
      this.taskMessage = '没有待完成任务'
      return
    }
    this.tasks = nextTasks
    this.taskMessage = '已完成下一项任务'
    this.syncTaskSummary()
    this.saveTasks()
  },

  removeCompletedTasks() {
    const pending = []
    for (let i = 0; i < this.tasks.length; i += 1) {
      if (!this.tasks[i].done) {
        pending.push(this.tasks[i])
      }
    }
    const removed = this.tasks.length - pending.length
    this.tasks = pending
    this.taskMessage = removed > 0 ? '已移除 ' + removed + ' 项已完成任务' : '没有可移除的任务'
    this.syncTaskSummary()
    this.saveTasks()
  },

  syncTaskSummary() {
    let done = 0
    let next = '今天的任务已全部完成'
    for (let i = 0; i < this.tasks.length; i += 1) {
      if (this.tasks[i].done) {
        done += 1
      } else if (next === '今天的任务已全部完成') {
        next = this.tasks[i].text
      }
    }
    this.taskCount = this.tasks.length
    this.doneCount = done
    this.pendingCount = this.tasks.length - done
    this.nextTaskText = this.tasks.length === 0 ? '还没有任务' : next
  },

  saveTasks() {
    storage.set({
      key: TASKS_KEY,
      value: JSON.stringify(this.tasks),
      fail: (data, code) => {
        this.taskMessage = '任务保存失败：' + code
      },
      complete: () => {}
    })
  },

  loadTasks() {
    storage.get({
      key: TASKS_KEY,
      success: (data) => {
        if (!data) {
          return
        }
        try {
          const saved = JSON.parse(data)
          if (saved && saved.length !== undefined) {
            this.tasks = saved
            this.syncTaskSummary()
          }
        } catch (error) {
          console.log('[study-terminal] invalid saved tasks')
        }
      },
      fail: () => {},
      complete: () => {}
    })
  },

  applyNetworkType(type) {
    const value = type || 'none'
    this.networkOnline = value !== 'none' && value !== 'unknown'
    if (!this.networkOnline) {
      this.networkType = '未连接'
    } else if (value === 'others' || value === 'ethernet') {
      this.networkType = '以太网'
    } else if (value === 'wifi') {
      this.networkType = 'WiFi'
    } else {
      this.networkType = value.toUpperCase()
    }
  },

  refreshStatus() {
    const now = new Date()
    this.statusUpdated = this.pad2(now.getHours()) + ':' + this.pad2(now.getMinutes()) + ':' + this.pad2(now.getSeconds())
    if (network && typeof network.getType === 'function') {
      network.getType({
        success: (data) => {
          this.applyNetworkType(data.type)
        },
        fail: (data, code) => {
          this.networkType = '不可用 (' + code + ')'
          this.networkOnline = false
        },
        complete: () => {}
      })
    } else {
      this.networkType = '不可用'
      this.networkOnline = false
    }

    if (battery && typeof battery.getStatus === 'function') {
      battery.getStatus({
        success: (data) => {
          this.batteryLevel = data.level
          this.batteryDisplay = data.level + '%'
          this.charging = data.charging
        },
        fail: (data, code) => {
          this.batteryLevel = '--'
          this.batteryDisplay = '不可用'
          console.log('[study-terminal] battery error ' + code)
        },
        complete: () => {}
      })
    } else {
      this.batteryLevel = '--'
      this.batteryDisplay = '不可用'
      this.charging = false
    }

    if (device && typeof device.getInfo === 'function') {
      device.getInfo({
        success: (data) => {
          this.deviceModel = data.model || data.product || 'openvela 设备'
          this.osVersion = (data.osType || 'openvela') + ' ' + (data.osVersionName || '')
          this.screenSize = data.screenWidth + ' × ' + data.screenHeight
          this.platformVersion = data.platformVersionName || '--'
        },
        fail: (data, code) => {
          this.deviceModel = '读取失败 (' + code + ')'
        },
        complete: () => {}
      })
    } else {
      this.deviceModel = '当前环境不可用'
      this.osVersion = '--'
      this.screenSize = '--'
      this.platformVersion = '--'
    }

    if (device && typeof device.getTotalStorage === 'function') {
      device.getTotalStorage({
        success: (data) => {
          this.totalStorage = this.formatStorage(data.totalStorage)
        },
        fail: () => {},
        complete: () => {}
      })
    } else {
      this.totalStorage = '--'
    }

    if (device && typeof device.getAvailableStorage === 'function') {
      device.getAvailableStorage({
        success: (data) => {
          this.availableStorage = this.formatStorage(data.availableStorage)
        },
        fail: () => {},
        complete: () => {}
      })
    } else {
      this.availableStorage = '--'
    }
  },

  formatStorage(bytes) {
    if (bytes === undefined || bytes === null) {
      return '--'
    }
    const megabytes = bytes / 1024 / 1024
    if (megabytes >= 1024) {
      return (megabytes / 1024).toFixed(1) + ' GB'
    }
    return megabytes.toFixed(1) + ' MB'
  },

  onAiInput(event) {
    this.aiQuery = event.value || ''
  },

  setAiReply(text) {
    const content = text || ''
    const lines = []
    for (let offset = 0; offset < content.length; offset += 46) {
      lines.push(content.slice(offset, offset + 46))
    }
    this.aiReply = content
    this.aiReplyLines = lines.length > 0 ? lines : ['AI 没有返回文字内容。']
  },

  askAI() {
    const query = (this.aiQuery || '').trim()
    if (!query) {
      this.aiMessage = '请先输入问题'
      return
    }
    if (this.aiBusy) {
      return
    }
    if (!velaclaw || typeof velaclaw.ask !== 'function') {
      this.aiBusy = false
      this.setAiReply('当前模拟器未提供端侧 AI 接口，请在 openvela QEMU 或真机中启动 ai_agent 后再试。')
      this.aiMessage = '当前环境不支持 system.velaclaw'
      return
    }
    this.lastQuestion = query
    this.setAiReply('正在连接端侧 AI Agent...')
    this.aiMessage = ''
    this.aiBusy = true
    velaclaw.ask({
      query: query,
      success: (result) => {
        this.setAiReply(result.reply || 'AI 已响应，但没有返回文字内容。')
      },
      fail: (data, code) => {
        this.setAiReply('AI 暂时不可用，请确认 ai_agent 已在后台运行。')
        this.aiMessage = '错误码：' + code
      },
      complete: () => {
        this.aiBusy = false
      }
    })
  },

  requestVoice(command, onSuccess) {
    if (this.aiBusy) {
      return
    }
    if (!velaclaw || typeof velaclaw.ask !== 'function') {
      this.voiceListening = false
      this.aiMessage = '当前模拟器不支持语音识别，请在 QEMU 或真机中验证'
      return
    }
    this.aiBusy = true
    velaclaw.ask({
      query: command,
      success: (result) => {
        onSuccess(result.reply || '')
      },
      fail: (data, code) => {
        this.voiceListening = false
        this.aiMessage = '语音识别失败，错误码：' + code
      },
      complete: () => {
        this.aiBusy = false
      }
    })
  },

  startVoiceInput() {
    if (this.voiceListening) {
      this.aiMessage = '正在听，请说完后点击“停止并识别”'
      return
    }
    this.aiMessage = '正在启动麦克风...'
    this.requestVoice('__VELACLAW_VOICE_START__', () => {
      this.voiceListening = true
      this.aiMessage = '正在听，请说完后点击“停止并识别”'
    })
  },

  stopVoiceInput() {
    if (!this.voiceListening) {
      this.aiMessage = '请先点击“开始说话”'
      return
    }
    this.aiMessage = '正在停止并识别...'
    this.requestVoice('__VELACLAW_VOICE_STOP__', (text) => {
      this.voiceListening = false
      if (text) {
        this.aiQuery = text
        this.aiMessage = '识别完成，请确认文字后发送'
      } else {
        this.aiMessage = '没有识别到文字，请重试'
      }
    })
  },

  askStatusPreset() {
    this.aiQuery = '请分析当前设备状态：网络 ' + this.networkType + '，电量 ' + this.batteryDisplay + '，可用存储 ' + this.availableStorage + '，并给出一条简短建议。'
    this.askAI()
  },

  askStudyPreset() {
    this.aiQuery = '我还有 ' + this.pendingCount + ' 项学习任务，下一项是“' + this.nextTaskText + '”。请给我一条简短、可执行的学习建议。'
    this.askAI()
  },

  onReminderSetting(event) {
    this.remindersEnabled = event.checked
    this.saveSettings()
  },

  onAutoRefreshSetting(event) {
    this.autoRefreshEnabled = event.checked
    this.applyAutoRefresh()
    this.saveSettings()
  },

  onFocusModeSetting(event) {
    this.focusModeEnabled = event.checked
    if (!this.focusModeEnabled) {
      this.resetFocus()
    }
    this.saveSettings()
  },

  applyAutoRefresh() {
    this.stopAutoRefresh()
    if (this.autoRefreshEnabled) {
      this.autoRefreshTimer = setInterval(() => {
        this.refreshStatus()
      }, 15000)
    }
  },

  stopAutoRefresh() {
    if (this.autoRefreshTimer) {
      clearInterval(this.autoRefreshTimer)
      this.autoRefreshTimer = null
    }
  },

  saveSettings() {
    const settings = {
      remindersEnabled: this.remindersEnabled,
      autoRefreshEnabled: this.autoRefreshEnabled,
      focusModeEnabled: this.focusModeEnabled
    }
    storage.set({
      key: SETTINGS_KEY,
      value: JSON.stringify(settings),
      success: () => {
        this.settingsMessage = '设置已保存'
      },
      fail: (data, code) => {
        this.settingsMessage = '设置保存失败：' + code
      },
      complete: () => {}
    })
  },

  loadSettings() {
    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        try {
          const settings = JSON.parse(data)
          if (settings.remindersEnabled !== undefined) {
            this.remindersEnabled = settings.remindersEnabled
          }
          if (settings.autoRefreshEnabled !== undefined) {
            this.autoRefreshEnabled = settings.autoRefreshEnabled
          }
          if (settings.focusModeEnabled !== undefined) {
            this.focusModeEnabled = settings.focusModeEnabled
          }
          this.applyAutoRefresh()
        } catch (error) {
          this.applyAutoRefresh()
        }
      },
      fail: () => {
        this.applyAutoRefresh()
      },
      complete: () => {}
    })
  },

  resetDemoData() {
    this.tasks = [
      { id: 1, text: '复习 openvela Quick App 基础', done: false },
      { id: 2, text: '验证 AI 助手工具调用', done: false },
      { id: 3, text: '整理今日演示记录', done: true }
    ]
    this.remindersEnabled = true
    this.autoRefreshEnabled = true
    this.focusModeEnabled = true
    this.syncTaskSummary()
    this.resetFocus()
    this.applyAutoRefresh()
    this.saveTasks()
    this.saveSettings()
    this.settingsMessage = '演示数据已恢复'
  }
}
</script>
