/* 创建顶部时间栏 - 参考 Windows 版本 */
static void create_header(lv_obj_t *parent)
{
  lv_obj_t *header;
  lv_obj_t *clock;
  lv_obj_t *title;
  time_t now;
  struct tm *timeinfo;
  char time_str[32];

  header = create_group(parent, LV_FLEX_FLOW_ROW);
  lv_obj_set_width(header, LV_PCT(100));
  lv_obj_set_height(header, 36);
  lv_obj_set_style_bg_color(header, color(0x0a1b2f), 0);
  lv_obj_set_style_bg_opa(header, LV_OPA_COVER, 0);
  lv_obj_set_style_pad_left(header, 16, 0);
  lv_obj_set_style_pad_right(header, 16, 0);
  lv_obj_set_flex_align(header, LV_FLEX_ALIGN_SPACE_BETWEEN,
                        LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

  /* 左侧：应用名称 */
  title = create_label(header, "AI Study Terminal", COLOR_WHITE);

  /* 右侧：时间 */
  now = time(NULL);
  timeinfo = localtime(&now);
  snprintf(time_str, sizeof(time_str), "%02d:%02d",
           timeinfo->tm_hour, timeinfo->tm_min);

  clock = create_label(header, time_str, COLOR_WHITE);
  g_ui.header_clock = clock;
}

